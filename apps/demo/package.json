{
  "name": "ingenui-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive demo for ingenui and @ingenui/incremental-jsx-parser: stream Markdown + UI (through a Worker running the ingenui server side) or JSX into a live React tree.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf:preview": "vite build && wrangler dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@ingenui/incremental-jsx-parser": "workspace:*",
    "ingenui": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.103.0"
  }
}
